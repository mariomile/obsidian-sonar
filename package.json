{
  "name": "sonar",
  "version": "0.1.2",
  "description": "A fast, relevance-first search engine for Obsidian.",
  "main": "main.js",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "bench": "node --experimental-strip-types scripts/bench.mjs"
  },
  "keywords": [
    "obsidian",
    "search",
    "bm25",
    "sonar"
  ],
  "author": "Mario Miletta",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "obsidian": "1.13.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
